{
  "manifest_version": 3,
  "name": "LocalLabel – Image & Video Annotation",
  "short_name": "LocalLabel",
  "version": "1.0.0",
  "description": "Label local images and videos for ML: boxes, polygons, masks, tracks, AI assist. Your files never leave your computer.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open LocalLabel",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["unlimitedStorage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
